<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="#173D2D"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Join the MatchPoint community"
            android:textSize="14sp"
            android:textColor="#697C70"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/etRegEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Password (6+ characters)"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etRegConfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etFirstName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="First Name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etLastName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Last Name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Address / City"
            android:inputType="textPostalAddress"
            android:singleLine="true"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="22dp"/>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="Register"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/progressRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
